# Main model (writes the replies). Free option: Groq, key from https://console.groq.com/keys
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_API_KEY=

# Router model (reads the message and returns JSON). Smaller and faster is fine.
# Leave these empty to reuse the main model settings.
ROUTER_PROVIDER=groq
ROUTER_MODEL=openai/gpt-oss-20b
ROUTER_API_KEY=

# Other options (swap provider + model, nothing else changes):
#   LLM_PROVIDER=gemini      LLM_MODEL=gemini-2.5-flash            (key from Google AI Studio)
#   LLM_PROVIDER=openrouter  LLM_MODEL=openai/gpt-oss-120b:free
#   LLM_PROVIDER=anthropic   LLM_MODEL=<model id>
#   LLM_PROVIDER=openai      LLM_MODEL=<model id>
#   LLM_PROVIDER=ollama      LLM_MODEL=qwen3:8b                    (runs on your own machine)
#   LLM_PROVIDER=openai_compatible  LLM_BASE_URL=https://your-endpoint/v1  LLM_MODEL=<model id>

# Database. Leave empty for a local SQLite file. docker-compose sets Postgres automatically.
DATABASE_URL=

# Test runner: seconds to wait between turns so free-tier rate limits are not hit
CASE_PAUSE_SECONDS=20
