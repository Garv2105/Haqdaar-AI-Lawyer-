  "case": {
    "id": "C06_salary_explain_then_practise",
    "tests": "Unpaid final settlement, explain, then role-play the HR manager for two turns and stop",
    "turns": [
      {
        "message": "I resigned from a startup in Noida. My last working day was 15 October 2026. They haven't paid my salary for September and October (Rs 45,000 per month) and say 'funds are stuck, wait 2-3 months'. I have my offer letter, payslips till August, and the HR emails."
      },
      {
        "message": "Can you pretend to be the HR manager so I can practise asking for my money?",
        "mode": "practise"
      },
      {
        "message": "Hi, I want my September and October salary. It has been almost a month since my last day."
      },
      {
        "message": "The law says you have to pay within 2 working days of resignation. I will go to the labour authority if I don't get it in 7 days."
      },
      {
        "message": "stop"
      }
    ],
